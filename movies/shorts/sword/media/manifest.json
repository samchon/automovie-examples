        "if ($LASTEXITCODE -ne 0) { throw 'The Last Carry render failed.' }",
        "$carryCandidate = Join-Path $carryRestore 'film.mp4'",
        "$carryMasterPath = 'media/automovie/the-last-carry/videos/film.mp4'",
        "$carryMaster = Join-Path (Get-Location).Path $carryMasterPath",
        "$carrySha256 = ((Get-Content -LiteralPath 'media/manifest.json' -Raw | ConvertFrom-Json).files | Where-Object path -eq $carryMasterPath).sha256",
        "if (!(Test-Path -LiteralPath $carryCandidate -PathType Leaf) -or (Get-FileHash -LiteralPath $carryCandidate -Algorithm SHA256 -ErrorAction Stop).Hash -ne $carrySha256) { throw 'The new render differs from the approved The Last Carry master.' }",
        "if (Test-Path -LiteralPath $carryMaster) { if ((Get-FileHash -LiteralPath $carryMaster -Algorithm SHA256 -ErrorAction Stop).Hash -ne $carrySha256) { throw 'The current The Last Carry playback path contains different bytes.' } } else { [IO.Directory]::CreateDirectory((Split-Path -LiteralPath $carryMaster)) | Out-Null; [IO.File]::Copy((Resolve-Path -LiteralPath $carryCandidate).Path, $carryMaster) }"
