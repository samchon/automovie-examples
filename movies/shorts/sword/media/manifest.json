        "$carryRestore = Join-Path '.cache/restored/the-last-carry' ([guid]::NewGuid().ToString('N'))",
        "if (!(Test-Path -LiteralPath 'media/automovie/the-last-carry/audios/the-last-carry-ensemble.wav' -PathType Leaf)) { node src/executable/the-last-carry-sound.mts --ensemble; if ($LASTEXITCODE -ne 0) { throw 'The Last Carry sound restoration failed.' } }",
