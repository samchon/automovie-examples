..Object.keys(AUTO_MOVIE_INSPECTION_PALETTE.defect).map(\n      (kind: string): string => `defect/${kind}`,\n    ),\n  ];\n\n  return {\n    name,\n    durationSeconds: scene.durationSeconds,\n    fps: scene.fps,\n    width: scene.width,\n    height: scene.height,\n    views: [\n      ...Object.keys(scene.views ?? {}),\n      ...autoMovieViewerNamedViewpoints().map(\n        (viewpoint: IAutoMovieViewerViewpoint): string => viewpoint.id,\n      ),\n    ],\n    drawables: [...boxes].map(\n      ([path, box]: [\n        string,\n        THREE.Box3,\n      ]): IAutoMovieCaptureSubject.IDrawable => ({\n        path,\n        min: { x: box.min.x, y: box.min.y, z: box.min.z },\n        max: { x: box.max.x, y: box.max.y, z: box.max.z },\n      }),\n    ),\n    marks: [...new Set<string>([...(scene.markKinds ?? []), ...supplied, ...measured])],\n    ...(scene.instants === undefined\n      ? {}\n      : {\n          instants: scene.instants.map(\n            (instant: {\n              seconds: number;\n              label: string;\n            }): IAutoMovieCaptureSubject.IInstant => ({\n              seconds: instant.seconds,\n              label: instant.label,\n            }),\n          ),\n        }),\n  };\n}\n"],"mappings":";;;;;;;;;;;;;;;;;;AAwBA,SAAgB,2BACd,MACA,OAC0B;CAE1B,MAAM,MAAM,kBAAkB,IAAI;CAClC,MAAM,wBAAiC,IAAI,IAAI;CAC/C,MAAM,UAAsC,6BAC1C,MAAM,KACR;CACA,KAAK,MAAM,SAAS,SAAS;EAC3B,MAAM,MAAkB,IAAI,MAAM,KAAK,CAAC,CAAC,cAAc,MAAM,MAAM;EACnE,IAAI,IAAI,QAAQ,GAAG;EACnB,MAAM,QAAgC,MAAM,IAAI,MAAM,IAAI;EAC1D,IAAI,UAAU,KAAA,GAAW,MAAM,IAAI,MAAM,MAAM,GAAG;OAC7C,MAAM,MAAM,GAAG;CACtB;CAGA,MAAM,YAAsB,MAAM,QAAQ,CAAC,KAAK,CAAC,EAAA,CAAG,KACjD,SAAiC,KAAK,IACzC;CACA,MAAM,WAAqB;EACzB;EACA;EACA;EACA,GAAG,OAAO,KAAK,8BAA8B,MAAM,CAAC,CAAC,KAClD,SAAyB,UAAU,MACtC;CACF;CAEA,OAAO;EACL;EACA,iBAAiB,MAAM;EACvB,KAAK,MAAM;EACX,OAAO,MAAM;EACb,QAAQ,MAAM;EACd,OAAO,CACL,GAAG,OAAO,KAAK,MAAM,SAAS,CAAC,CAAC,GAChC,GAAG,+BAA+B,CAAC,CAAC,KACjC,cAAiD,UAAU,EAC9D,CACF;EACA,WAAW,CAAC,GAAG,KAAK,CAAC,CAAC,KAC