{
  "name": "automovie-examples",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "description": "AutoMovie example productions, developed against a local automovie checkout.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "pnpm --recursive --if-present run lint",
    "evidence": "pnpm --recursive --if-present run evidence",
    "test": "pnpm --recursive --if-present run test"
  },
  "devDependencies": {
    "automovie": "catalog:automovie"
  }
}
